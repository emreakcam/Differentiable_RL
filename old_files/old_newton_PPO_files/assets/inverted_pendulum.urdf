<?xml version="1.0"?>
<robot name="inverted_pendulum">
  <link name="base">
  </link>

  <link name="pendulum">
    <inertial>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0834" ixy="0" ixz="0" iyy="0.0834" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.5"/>
      </geometry>
      <material name="gray">
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.5"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_to_pendulum" type="revolute">
    <parent link="base"/>
    <child link="pendulum"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-10000" upper="10000"/>
  </joint>
</robot>
